@page "/wasteentries"
@rendermode InteractiveServer

@using WasteTracker.Web.Models
@using WasteTracker.Web.Services
@inject HttpClient Http
@inject AuthService Auth
@inject NavigationManager Nav

@if (redirecting)
{
    <p>Redirecting to login...</p>
    return;
}

<h3>Waste Entries</h3>

@if (entries is null)
{
    <p><em>Loading...</em></p>
}
else if (entries.Count == 0)
{
    <p><em>No entries found.</em></p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Site</th>
                <th>Waste Type</th>
                <th>Handling Method</th>
                <th>Quantity (kg)</th>
                <th>Date</th>

                @if (Auth.IsAdmin)
                {
                    <th>Actions</th>
                }
            </tr>
        </thead>
        <tbody>
        @foreach (var entry in entries)
        {
            <tr>
                <td>@(entry.Site?.Name ?? "Unknown")</td>
                <td>@(entry.WasteType?.Name ?? "Unknown")</td>
                <td>@(entry.HandlingMethod?.Method ?? "Unknown")</td>
                <td>@entry.QuantityKg</td>
                <td>@entry.Date.ToShortDateString()</td>

                @if (Auth.IsAdmin)
                {
                    <td>
                        <button class="btn btn-sm btn-danger"
                                @onclick="() => DeleteEntry(entry.EntryId)">
                            Delete
                        </button>
                    </td>
                }
            </tr>
        }
        </tbody>
    </table>
}

@code {
    private List<WasteEntry>? entries;
    private bool redirecting = false;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsLoggedIn)
        {
            redirecting = true;
            Nav.NavigateTo("/login", true);
            return;
        }

        try
        {
            entries = await Http.GetFromJsonAsync<List<WasteEntry>>("wasteentries");
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error fetching data: {ex.Message}");
            entries = new List<WasteEntry>();
        }
    }

    private async Task DeleteEntry(int id)
    {
        if (!Auth.IsAdmin)
            return;

        var response = await Http.DeleteAsync($"wasteentries/{id}");

        if (response.IsSuccessStatusCode)
        {
            var item = entries?.FirstOrDefault(e => e.EntryId == id);
            if (item != null)
            {
                entries?.Remove(item);
                StateHasChanged();
            }
        }
        else
        {
            Console.WriteLine("Failed to delete entry.");
        }
    }
}
