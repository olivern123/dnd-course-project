@page "/add-wasteentry"
@rendermode InteractiveServer

@using WasteTracker.Web.Services
@using WasteTracker.Web.Models
@using Microsoft.AspNetCore.Components.Forms
@using ClosedXML.Excel
@using System.Globalization

@inject HttpClient Http
@inject AuthService Auth
@inject NavigationManager Nav

<h3>Import Waste from Excel (Opgørelse PO xxxx.xlsx)</h3>

<p>
    Select one or more <strong>Opgørelse PO xxxx.xlsx</strong> files.<br />
    The system extracts <strong>Spild ialt</strong> from sheet <strong>Data Input</strong>,
    creates a <code>WasteEntry</code>, and saves the original Excel file in the database.
</p>

<hr />

<div class="row">
    <div class="col-md-4">
        <div class="mb-3">
            <label class="form-label">Default Site ID</label>
            <InputNumber class="form-control" @bind-Value="defaultSiteId" />
        </div>

        <div class="mb-3">
            <label class="form-label">Default Waste Type ID</label>
            <InputNumber class="form-control" @bind-Value="defaultWasteTypeId" />
        </div>

        <div class="mb-3">
            <label class="form-label">Default Handling Method ID</label>
            <InputNumber class="form-control" @bind-Value="defaultHandlingId" />
        </div>
    </div>

    <div class="col-md-8">
        <div class="mb-3">
            <label class="form-label">Excel Files (Opgørelse)</label>
            <InputFile OnChange="HandleFilesSelected" multiple class="form-control" />
        </div>

        @if (selectedFilesInfos?.Count > 0)
        {
            <h5 class="mt-3">Parsed Preview</h5>
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th></th>
                        <th>File</th>
                        <th>Date</th>
                        <th>Total (Spild ialt)</th>
                        <th>Kantspild (I12)</th>
                        <th>Kvalitetsspild (I13)</th>
                        <th>Other</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in selectedFilesInfos)
                    {
                        <tr>
                            <td><input type="checkbox" @bind="f.Include" /></td>
                            <td>@f.File.Name</td>
                            <td>@f.Date:yyyy-MM-dd</td>
                            <td>@f.Waste</td>
                            <td>@f.Kant</td>
                            <td>@f.Kvalitet</td>
                            <td>@f.Other</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <button class="btn btn-primary"
            @onclick="UploadAndImport"
            disabled="@(selectedFilesInfos?.Count == 0)">
            Import to WasteEntries
        </button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(success))
{
    <div class="alert alert-success mt-3">@success</div>
}
@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger mt-3">@error</div>
}

@if (importLog.Count > 0)
{
    <h5 class="mt-4">Import Log</h5>
    <ul>
        @foreach (var line in importLog)
        {
            <li>@line</li>
        }
    </ul>
}

@code {

    // ---------------------------
    // LOGIN PROTECTION
    // ---------------------------
    protected override void OnInitialized()
    {
        if (!Auth.IsLoggedIn)
        {
            Nav.NavigateTo("/login", true);
            return;
        }
    }

    private class SelectedFileInfo
    {
        public IBrowserFile File { get; set; } = default!;
        public bool Include { get; set; } = true;
        public decimal Waste { get; set; }
        public decimal Kant { get; set; }
        public decimal Kvalitet { get; set; }
        public decimal Other { get; set; }
        public DateTime Date { get; set; }
    }

    private List<SelectedFileInfo> selectedFilesInfos = new();
    private int defaultSiteId = 1;
    private int defaultWasteTypeId = 1;
    private int defaultHandlingId = 1;

    private string? success;
    private string? error;
    private List<string> importLog = new();

    private async Task HandleFilesSelected(InputFileChangeEventArgs e)
    {
        success = error = null;
        importLog.Clear();
        selectedFilesInfos.Clear();

        var files = e.GetMultipleFiles().ToList();
        foreach (var file in files)
        {
            try
            {
                var preview = await ParsePreviewAsync(file);
                preview.File = file;
                selectedFilesInfos.Add(preview);
            }
            catch (Exception ex)
            {
                importLog.Add($"{file.Name}: Preview parse error: {ex.Message}");
            }
        }
    }

    // Robust parsing helpers: find label cells anywhere and parse adjacent/right cells, tolerant to formatting
    private decimal TryParseCellValue(IXLCell? cell)
    {
        if (cell == null) return 0;
        try
        {
            if (cell.DataType == XLDataType.Number)
            {
                try { return Convert.ToDecimal(cell.GetDouble()); } catch { }
            }

            var s = cell.GetString();
            if (string.IsNullOrWhiteSpace(s)) return 0;

            // Remove non-breaking spaces and normal spaces used as thousand separators
            s = s.Replace("\u00A0", "").Replace(" ", "").Trim();

            // Handle parentheses for negatives
            var isNegative = s.StartsWith("(") && s.EndsWith(")");
            s = s.Replace("(", "").Replace(")", "");

            // Replace comma with dot for invariant parse, but allow either
            s = s.Replace(',', '.');

            // Remove any non-digit except dot and minus
            var filtered = new System.Text.StringBuilder();
            foreach (var ch in s)
            {
                if ((ch >= '0' && ch <= '9') || ch == '.' || ch == '-') filtered.Append(ch);
            }

            var cleaned = filtered.ToString();
            if (string.IsNullOrWhiteSpace(cleaned)) return 0;

            if (decimal.TryParse(cleaned, NumberStyles.Number | NumberStyles.AllowLeadingSign | NumberStyles.AllowDecimalPoint, CultureInfo.InvariantCulture, out var v))
            {
                return isNegative ? -v : v;
            }
        }
        catch { }

        return 0;
    }

    private DateTime TryParseDateCell(IXLCell? cell)
    {
        if (cell == null) return DateTime.Today;
        try
        {
            if (cell.DataType == XLDataType.DateTime)
                return cell.GetDateTime();

            var s = cell.GetString();
            if (string.IsNullOrWhiteSpace(s)) return DateTime.Today;

            // Try standard date parse with Danish locale
            if (DateTime.TryParse(s, CultureInfo.GetCultureInfo("da-DK"), DateTimeStyles.None, out var dt))
                return dt;

            // Try invariant (ISO) parse
            if (DateTime.TryParse(s, CultureInfo.InvariantCulture, DateTimeStyles.None, out var dt2))
                return dt2;
        }
        catch { }

        return DateTime.Today;
    }

    private decimal FindLabelRightValue(IXLWorksheet ws, string label)
    {
        var cell = ws.CellsUsed().FirstOrDefault(c => c.GetString().IndexOf(label, StringComparison.OrdinalIgnoreCase) >= 0);
        if (cell == null) return 0;
        var right = ws.Cell(cell.Address.RowNumber, cell.Address.ColumnNumber + 1);
        return TryParseCellValue(right);
    }

    private async Task<SelectedFileInfo> ParsePreviewAsync(IBrowserFile file)
    {
        using var ms = new MemoryStream();
        await file.OpenReadStream(20_000_000).CopyToAsync(ms);
        ms.Position = 0;

        using var workbook = new XLWorkbook(ms);

        var ws = workbook.Worksheets.FirstOrDefault(w => w.Name.Trim().Equals("Data Input", StringComparison.OrdinalIgnoreCase))
                 ?? workbook.Worksheet(1);

        DateTime date = DateTime.Today;
        // Find date cell anywhere labelled 'Dato'
        var dateCell = ws.CellsUsed().FirstOrDefault(c => c.GetString().IndexOf("Dato", StringComparison.OrdinalIgnoreCase) >= 0);
        if (dateCell != null)
        {
            var right = ws.Cell(dateCell.Address.RowNumber, dateCell.Address.ColumnNumber + 1);
            date = TryParseDateCell(right);
        }

        // Find total 'Spild ialt' anywhere and get the cell to the right
        decimal waste = FindLabelRightValue(ws, "Spild ialt");

        var wsResult = workbook.Worksheets.FirstOrDefault(w => w.Name.Trim().Equals("Data Resultat", StringComparison.OrdinalIgnoreCase));
        decimal kant = 0;
        decimal kvalitet = 0;
        if (wsResult != null)
        {
            // Use direct cell reference I12/I13 if present, otherwise fallback to find label
            try { kant = TryParseCellValue(wsResult.Cell("I12")); } catch { kant = 0; }
            try { kvalitet = TryParseCellValue(wsResult.Cell("I13")); } catch { kvalitet = 0; }
            if (kant == 0) kant = FindLabelRightValue(wsResult, "Kantspild");
            if (kvalitet == 0) kvalitet = FindLabelRightValue(wsResult, "Kvalitetsspild");
        }

        var other = waste - kant - kvalitet;
        if (other < 0) other = 0;

        return new SelectedFileInfo
        {
            Waste = waste,
            Kant = kant,
            Kvalitet = kvalitet,
            Other = other,
            Date = date
        };
    }

    private async Task UploadAndImport()
    {
        success = error = null;

        var toImport = selectedFilesInfos.Where(f => f.Include).ToList();
        if (toImport.Count == 0)
        {
            error = "Please select one or more files to import (check the boxes).";
            return;
        }

        int imported = 0;
        decimal totalWaste = 0;

        foreach (var sfi in toImport)
        {
            var file = sfi.File;
            try
            {
                using var ms = new MemoryStream();
                await file.OpenReadStream(20_000_000).CopyToAsync(ms);
                ms.Position = 0;

                // Reuse parsed preview values (sfi)
                var date = sfi.Date;
                var kant = sfi.Kant;
                var kvalitet = sfi.Kvalitet;
                var other = sfi.Other;

                // 70% of kvalitetsspild goes to internal reuse, the rest goes to other waste
                var internalReuseQty = kvalitet * 0.7m;
                var otherFromKvalitet = kvalitet * 0.3m;
                var totalOther = other + otherFromKvalitet;

                if (sfi.Waste <= 0 && kant <= 0 && kvalitet <= 0 && other <= 0)
                {
                    importLog.Add($"{file.Name}: No quantities found in preview, skipping.");
                    continue;
                }

                var fileBytes = ms.ToArray();
                var createdEntries = new List<WasteEntry>();

                async Task<WasteEntry?> CreateEntryAsync(int wasteTypeId, decimal qty)
                {
                    if (qty <= 0) return null;
                    var e = new WasteEntry
                    {
                        SiteId = defaultSiteId,
                        WasteTypeId = wasteTypeId,
                        HandlingId = defaultHandlingId,
                        QuantityKg = qty,
                        Date = date
                    };

                    var r = await Http.PostAsJsonAsync("wasteentries", e);
                    if (!r.IsSuccessStatusCode) return null;
                    return await r.Content.ReadFromJsonAsync<WasteEntry>();
                }

                var kantEntry = await CreateEntryAsync(4, kant);
                if (kantEntry != null) createdEntries.Add(kantEntry);

                var reuseEntry = await CreateEntryAsync(5, internalReuseQty);
                if (reuseEntry != null) createdEntries.Add(reuseEntry);

                var otherEntry = await CreateEntryAsync(defaultWasteTypeId, totalOther);
                if (otherEntry != null) createdEntries.Add(otherEntry);

                if (createdEntries.Count == 0)
                {
                    importLog.Add($"{file.Name}: No waste entries were created from file (quantities were zero or API errors).");
                    continue;
                }

                foreach (var ce in createdEntries)
                {
                    var uploadObject = new
                    {
                        FileName = file.Name,
                        Content = fileBytes,
                        WasteEntryId = ce.EntryId
                    };

                    var uploadResp = await Http.PostAsJsonAsync("uploadedfiles", uploadObject);
                    if (!uploadResp.IsSuccessStatusCode)
                    {
                        importLog.Add($"{file.Name}: File upload failed for EntryId {ce.EntryId}.");
                    }
                }

                imported += createdEntries.Count;
                totalWaste += createdEntries.Sum(x => x.QuantityKg);
                foreach (var ce in createdEntries)
                {
                    importLog.Add($"{file.Name}: Imported {ce.QuantityKg} kg as {ce.WasteTypeId} (EntryId {ce.EntryId}) date {ce.Date:yyyy-MM-dd}.");
                }
            }
            catch (Exception ex)
            {
                importLog.Add($"{file.Name}: ERROR {ex.Message}");
            }
        }

        if (imported > 0)
            success = $"Imported {imported} entries. Total waste: {totalWaste} kg.";
        else
            error = "No files imported. See log.";
    }
}
