@page "/dashboard"
@using WasteTracker.Web.Models
@using WasteTracker.Web.Services
@inject WasteService WasteService

<h3>Waste Overview</h3>

@if (entries == null)
{
    <p><em>Loading...</em></p>
}
else if (!entries.Any())
{
    <p>No waste entries found.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Site</th>
                <th>Waste Type</th>
                <th>Handling Method</th>
                <th>Quantity (kg)</th>
                <th>Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entry in entries)
            {
                <tr>
                    <td>@entry.Site?.Name</td>
                    <td>@entry.WasteType?.Name</td>
                    <td>@entry.HandlingMethod?.Method</td>
                    <td>@entry.QuantityKg</td>
                    <td>@entry.Date.ToShortDateString()</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<WasteEntry>? entries;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            entries = await WasteService.GetAllAsync();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading waste entries: {ex.Message}");
            entries = new List<WasteEntry>();
        }
    }
}
